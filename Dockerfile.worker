# syntax=docker/dockerfile:1
# Imagem do worker. Fica na RAIZ do repo para que o contexto de build seja a raiz
# (monorepo: copia pnpm-lock.yaml/packages/ da raiz). No EasyPanel: Source Path =
# vazio/raiz, Dockerfile Path = Dockerfile.worker.
#   docker build -f Dockerfile.worker .
#
# ┌─ generate_pdf (.docx nativo → PDF via LibreOffice) ───────────────────────┐
# │ build_working_docx monta o rascunho; generate_pdf converte o Word          │
# │ editado/aprovado via LibreOffice headless. Por isso a base                  │
# │ node:22-slim basta; o LibreOffice é instalado no estágio runner abaixo.    │
# └────────────────────────────────────────────────────────────────────────────┘

# --- base: Node + pnpm (via corepack, versão fixada em package.json) ---
# Trixie explícito: libheif-plugin-libde265 pertence a esta distribuição.
# Não usar o alias slim, cuja distribuição pode mudar independentemente do build.
FROM node:22-trixie-slim AS base
ENV PNPM_HOME="/pnpm" PATH="/pnpm:$PATH" CI=true
RUN corepack enable
WORKDIR /app

# --- deps: instala dependências do monorepo (camada cacheável pelos manifests) ---
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/core/package.json packages/core/package.json
COPY packages/db/package.json packages/db/package.json
COPY apps/worker/package.json apps/worker/package.json
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# HEIC/HEVC é decodificado por libheif; Sharp recebe o PNG intermediário.

# --- runner: fonte + execução via tsx (core/db são TS, sem build) ---
FROM deps AS runner

# ┌─ LibreOffice headless (render_sheets + generate_pdf) ──────────────────────┐
# │ render_sheets exporta abas do Excel como PDF com `libreoffice-calc` e usa   │
# │ `pdftoppm` (poppler-utils) para gerar PNG de forma previsível.               │
# │ generate_pdf monta o .docx nativo e converte para PDF via macro UNO         │
# │ (`libreoffice-writer`). Fontes Carlito/Caladea = clones métricos de         │
# │ Calibri/Cambria para fidelidade tipográfica.                                │
# └────────────────────────────────────────────────────────────────────────────┘
RUN apt-get update && apt-get install -y --no-install-recommends \
      libreoffice-calc libreoffice-writer libreoffice-draw poppler-utils fonts-crosextra-carlito fonts-crosextra-caladea \
      libheif-examples libheif-plugin-libde265 \
    && (command -v heif-convert || ln -s /usr/bin/heif-dec /usr/local/bin/heif-convert) \
    && heif-convert --help >/dev/null \
    && rm -rf /var/lib/apt/lists/*
# Perfil do LibreOffice (macro de conversão) num caminho gravável pelo usuário node.
ENV LO_PROFILE_DIR=/tmp/naabsa-lo

COPY packages ./packages
COPY apps/worker ./apps/worker
COPY templates/draft_survey.clean.docx ./templates/draft_survey.clean.docx
ENV NODE_ENV=production
# node:22-slim já inclui o usuário não-root `node`.
USER node
WORKDIR /app/apps/worker
# Roda o tsx DIRETO (sem `pnpm run`). O `pnpm run` faz "verify-deps-before-run" no
# start, que dispara um `pnpm install` — mas o store do pnpm é um cache de build
# (ausente no runtime) e sem rede → falha com exit 243. `node --import tsx` dispensa
# o pnpm. As envs vêm da plataforma (EasyPanel) / do compose (env_file).
CMD ["node", "--import", "tsx", "src/index.ts"]
