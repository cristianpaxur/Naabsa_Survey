{
  "name": "@naabsa/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env.local -e ../../.env -- tsx watch src/index.ts",
    "start": "dotenv -e ../../.env.local -e ../../.env -- tsx src/index.ts",
    "start:container": "tsx src/index.ts",
    "diagnose": "dotenv -e ../../.env.local -e ../../.env -- tsx ../../scripts/diagnose-env.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@naabsa/core": "workspace:*",
    "@naabsa/db": "workspace:*",
    "@supabase/supabase-js": "^2.108.1",
    "docx": "^9.7.1",
    "docxtemplater": "^3.69.0",
    "docxtemplater-image-module-free": "^1.1.1",
    "exceljs": "^4.4.0",
    "pg-boss": "^12.18.3",
    "pizzip": "^3.2.0",
    "playwright": "^1.60.0",
    "sharp": "^0.35.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "dotenv-cli": "^7.4.4",
    "tsx": "^4.19.2",
    "vitest": "^2.1.9"
  }
}
