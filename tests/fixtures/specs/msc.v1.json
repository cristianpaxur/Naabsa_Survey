      { "id": "sludge_misc",         "label": "Sludge — miscellaneous",   "sheet": "Sludge",   "range": "B11:L13" },
      { "id": "sludge_tanks_before", "label": "Sludge tanks (before)",    "sheet": "Sludge",   "range": "B16:I23" },
      { "id": "sludge_tanks_after",  "label": "Sludge tanks (after)",     "sheet": "Sludge",   "range": "H16:I23" }
