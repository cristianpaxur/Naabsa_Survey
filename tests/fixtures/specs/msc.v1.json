  "validations": [
    { "rule": "range", "field": "loa",           "min": 50,   "max": 400,   "level": "warning", "message": "LOA fora do intervalo usual (50–400 m) — confira Summary!B31." },
    { "rule": "range", "field": "gross_tonnage", "min": 0,    "max": 300000, "level": "warning", "message": "GRT fora do intervalo usual — confira Summary!B24." }
  ],

  "photo_slots": [
